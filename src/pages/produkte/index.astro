---
/**
 * Products index — DE.
 *
 * Empty-state branch: BASELINE_COPY.md §5 verbatim, single-column centered,
 * atmospheric arc bottom-right at low opacity. Source of truth for layout
 * is design/handoff-bundle/design/styles/products.css for the arc + closing
 * line treatment; the `.prod-meta` asymmetric-grid rules are not used (spec
 * §6.1 — Path 2 decision dropped the Status meta block).
 *
 * Populated-state branch: stacked product entries (H2 name link + tagline +
 * description + arrow link to detail page). Renders on dev once G C.2.b
 * lands the Thalura entry; on prod it stays empty as long as no non-draft
 * non-future-dated products exist.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUiStrings } from '../../i18n';
import { getVisibleProducts } from '../../lib/products';

const t = getUiStrings('de');
const products = await getVisibleProducts('de');

const title = t.productsIndex.h1;
const description =
  'Hier entstehen die Produkte von Blackbrowed Labs. Schwerpunkt: Werkzeuge für die Klassenführung.';
---

<BaseLayout title={`${title} — Blackbrowed Labs`} description={description}>
  <nav class="breadcrumb" aria-label={t.breadcrumb.ariaLabel}>
    <div class="breadcrumb__inner">
      <a href="/">Blackbrowed Labs</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__current" aria-current="page">{t.productsIndex.breadcrumb}</span>
    </div>
  </nav>

  <article class="products-index">
    <div class="products-index__container">
      {products.length === 0 ? (
        <div class="products-index__empty">
          <h1>{title}</h1>
          <p class="products-index__lead">
            Hier entstehen die Produkte von Blackbrowed Labs. Der Schwerpunkt liegt auf der
            Klassenführung: eine iPad-App, die Noten, Schülerleistungen und Beobachtungen
            ohne Papierkram verwaltet, sowie ein Claude-Cowork-Plugin für die
            Unterrichtsplanung.
          </p>
          <p class="products-index__lead">
            Sobald das erste Werkzeug veröffentlicht ist, findet sich an dieser Stelle eine
            kurze Beschreibung, die aktuelle Version und die jüngsten Release Notes — dazu
            ein Link zur jeweiligen Produktwebsite.
          </p>
          <div class="products-index__closing">
            <p>Bis dahin: Geduld. Gute Werkzeuge brauchen Zeit.</p>
          </div>
        </div>
      ) : (
        <div class="products-index__populated">
          <h1>{title}</h1>
          <ul class="products-index__list" role="list">
            {products.map((entry) => (
              <li class="products-index__item">
                <h2 class="products-index__name">
                  <a href={`/produkte/${entry.data.slug}/`}>{entry.data.name}</a>
                </h2>
                <p class="products-index__tagline">{entry.data.tagline}</p>
                <p class="products-index__description">{entry.data.description}</p>
                <a class="products-index__more" href={`/produkte/${entry.data.slug}/`}>
                  {t.productsIndex.populatedArrowLabel}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <svg
      class="products-index__atmos"
      viewBox="0 0 300 120"
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={t.productsIndex.arcAriaLabel}
    >
      <path
        fill="currentColor"
        d="M 14 96 C 60 82, 100 56, 138 36 C 152 28, 166 25, 180 28 C 208 40, 244 64, 286 86 C 244 78, 214 60, 190 48 C 178 45, 168 45, 158 48 C 138 54, 114 68, 84 80 C 62 93, 40 99, 20 102 L 14 96 Z"
      />
    </svg>
  </article>
</BaseLayout>
